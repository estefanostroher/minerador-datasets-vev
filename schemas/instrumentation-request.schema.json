{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://robo-minerador.local/instrumentation-request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "request_id", "operation", "snapshot_id", "root", "tsconfig_paths", "framework", "framework_version"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "operation": {"const": "instrument_snapshot"},
    "snapshot_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "root": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!.*(?:\u0000|\\\\|(?:^|/)\\.\\.?(?:/|$)))(?:/|[A-Za-z]:/).+$"},
    "tsconfig_paths": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:\u0000|:|\\\\|(?:^|/)\\.\\.?(?:/|$)|//)).+\\.json$"}},
    "framework": {"enum": ["jest", "vitest"]},
    "framework_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  }
}
